{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "0.6.0",
  "identifier": "dev.pulse.visualizer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pulse",
        "width": 1600,
        "height": 900,
        "minWidth": 640,
        "minHeight": 360,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' pulsemode: http://pulsemode.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: pulsemode: http://pulsemode.localhost",
        "font-src": "'self' data:",
        "media-src": "'self' blob: mediastream:",
        "connect-src": "'self' ipc: http://ipc.localhost https://khzccudtycrkbbqiwxmi.supabase.co",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": { "depends": ["libpulse0"] },
      "rpm": { "depends": ["pulseaudio-libs"] }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGOEREODA4ODM3MTdGQUIKUldTcmYzR0RDTmlOTCtQTnZTMTJWR08zSDdUak1qaDczSS9DVzcxdTYzbE9mMTkxK3N2OGR6ODQK",
      "endpoints": ["https://github.com/byGamsa/pulse-audio-visualizer/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
